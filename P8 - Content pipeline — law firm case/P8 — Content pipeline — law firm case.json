      "parameters": {
        "jsCode": "const parsed = JSON.parse($json.resultado_limpio);\n\nreturn {\n  Fecha: $('Preparar Tema').item.json.Fecha,\n  Tema: $('Preparar Tema').item.json.Tema,\n  Post_IG: parsed.post_ig,\n  Post_LinkedIn: parsed.post_linkedin,\n  Articulo_SEO: parsed.articulo_seo,\n  Estado: 'Generado'\n};"
