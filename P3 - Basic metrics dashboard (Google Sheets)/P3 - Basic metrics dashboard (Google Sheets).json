      "parameters": {
        "jsCode": "const fecha = new Date().toISOString().split('T')[0];\nconst leads = Math.floor(Math.random() * 50) + 10;\nconst ventas = Math.floor(Math.random() * leads);\nconst ingreso = ventas * (Math.floor(Math.random() * 500) + 100);\n\nreturn [{\n  json: {\n    fecha,\n    leads,\n    ventas,\n    ingreso,\n    conversion: ((ventas / leads) * 100).toFixed(1)\n  }\n}];"
      },
