    {
      "parameters": {
        "jsCode": "const rows = items.map(i => i.json);\n\nconst totalLeads = rows.reduce((sum, r) => sum + Number(r.leads), 0);\nconst totalVentas = rows.reduce((sum, r) => sum + Number(r.ventas), 0);\nconst totalIngreso = rows.reduce((sum, r) => sum + Number(r.ingreso), 0);\nconst conversionPromedio = ((totalVentas / totalLeads) * 100).toFixed(1);\n\nreturn [{\n  json: {\n    fecha_actualizacion: new Date().toISOString().split('T')[0],\n    total_leads: totalLeads,\n    total_ventas: totalVentas,\n    total_ingreso: totalIngreso,\n    conversion_promedio: conversionPromedio\n  }\n}];"
      },
