    {
      "parameters": {
        "jsCode": "// Costo operativo fijo mensual estimado (APIs + infraestructura)\nconst COSTO_FIJO_MENSUAL = 50; // ajustá este número a tu costo real\n\nconst items = $input.all();\nconst filas = items.map(i => i.json);\n\nconst ingresoTotal = filas.reduce((sum, f) => sum + Number(f.monto_usd || 0), 0);\nconst cantidadDeals = filas.length;\nconst roi = ingresoTotal > 0\n  ? (((ingresoTotal - COSTO_FIJO_MENSUAL) / COSTO_FIJO_MENSUAL) * 100).toFixed(1)\n  : 0;\n\nreturn [{\n  json: {\n    fecha_reporte: new Date().toISOString().split('T')[0],\n    ingreso_total: ingresoTotal,\n    costo_operativo: COSTO_FIJO_MENSUAL,\n    cantidad_deals: cantidadDeals,\n    roi_porcentaje: roi,\n    detalle_deals: filas\n  }\n}];"
      },
