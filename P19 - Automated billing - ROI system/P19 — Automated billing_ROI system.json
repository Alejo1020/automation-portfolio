    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: \"claude-sonnet-5\",\n  max_tokens: 500,\n  messages: [{\n    role: \"user\",\n    content: \"Eres un asesor financiero para pequeños negocios de servicios. Con estos datos de ingresos y costos operativos de un sistema de automatización, escribe un resumen ejecutivo breve (máximo 120 palabras) para el dueño del negocio, en español latino neutro, sin tecnicismos. Incluye: ingreso total, ROI, y una recomendación breve. Datos: \" + JSON.stringify($json)\n  }]\n}) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
