    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst originales = $('Code: Evaluar quién necesita mensaje ahora').all();\n\nreturn items.map((item, i) => {\n  return {\n    json: {\n      row_number: originales[i].json.row_number,\n      nombre: originales[i].json.nombre,\n      telefono: originales[i].json.telefono,\n      categoria: originales[i].json.categoria,\n      etapa_nutricion: originales[i].json.etapa_nutricion,\n      siguiente_etapa: originales[i].json.siguiente_etapa,\n      mensaje: item.json.content[0].text\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -576,
        400
      ],
      "id": "72d3b245-1729-4cf0-9490-1f65816fe725",
      "name": "Code: extraer el mensaje del response de Claude"
    },
    {
      "parameters": {
        "jsCode": "const umbrales = {\n  caliente: [0, 4, 24],\n  tibio: [24, 72, 168],\n  frio: [168, 504, 1080]\n};\n\nconst ahora = new Date();\nconst resultado = [];\n\nfor (const item of $input.all()) {\n  const d = item.json;\n\n  if (d.estado !== 'activo') continue;\n\n  const etapa = Number(d.etapa_nutricion);\n  const seq = umbrales[d.categoria];\n\n  if (!seq || etapa >= seq.length) continue;\n\n  const horasRequeridas = seq[etapa];\n  const ultimaFecha = new Date(d.ultima_actualizacion);\n  const horasTranscurridas = (ahora - ultimaFecha) / (1000 * 60 * 60);\n\n  if (horasTranscurridas >= horasRequeridas) {\n    resultado.push({\n      json: {\n        row_number: d.row_number,\n        nombre: d.nombre,\n        telefono: d.telefono,\n        categoria: d.categoria,\n        etapa_nutricion: etapa,\n        siguiente_etapa: etapa + 1,\n        fecha_ingreso: d.fecha_ingreso\n      }\n    });\n  }\n}\n\nreturn resultado;"
      },
