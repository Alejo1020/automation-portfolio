    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "{\n  \"anthropic-version\": \"2023-06-01\",\n  \"content-type\": \"application/json\"\n}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: \"claude-sonnet-5\",\n  max_tokens: 300,\n  messages: [\n    {\n      role: \"user\",\n      content: \"Eres un asistente de ventas por WhatsApp para un negocio en Medellín, Colombia. Escribe un mensaje corto (máx 3 líneas), cálido y natural en español colombiano, para un lead llamado \" + $json.nombre + \", categoría \" + $json.categoria + \", en el punto de contacto número \" + $json.siguiente_etapa + \" de la secuencia de seguimiento. Si es caliente: genera urgencia y ofrece cerrar la conversación pronto. Si es tibio: educa y genera confianza sin presionar. Si es frío: mantén presencia suave, sin sonar insistente. No uses emojis en exceso, máximo 1. Responde SOLO con el texto del mensaje, sin comillas ni explicación adicional.\"\n    }\n  ]\n}) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
