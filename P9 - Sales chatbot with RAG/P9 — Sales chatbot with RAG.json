      "name": "Sticky Note1"
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "base_conocimiento",
        "options": {}
      },
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [576, -112],
      "id": "23ed63b5-a0e5-4da7-9b19-53460989da70",
      "name": "Aggregate"
    },
    {
      "parameters": {
        "content": "📦 BUNDLE CONTEXT / EMPAQUETAR CONTEXTO\n\nMerges all knowledge base rows into a single array to pass as one context block to Gemini.\nJunta todas las filas de la base de conocimiento en un solo array para pasarlas como un único bloque de contexto a Gemini.",
        "height": 336,
        "width": 480
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [384, -320],
      "id": "6f8314a7-ba0f-4794-b922-66453bb723b8",
      "name": "Sticky Note2"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-latest:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  contents: [{\n    parts: [{\n      text: \"Eres el asistente virtual de una clínica estética en Medellín. Responde el mensaje del cliente usando SOLO la información de esta base de conocimiento, en tono cálido y profesional, breve (máx 80 palabras), en español. Si la pregunta no se puede responder con esta info, dices que un asesor humano se comunicará. Base de conocimiento: \" + JSON.stringify($json.base_conocimiento) + \". Mensaje del cliente: \" + $('Webhook').item.json.body.Body\n    }]\n  }]\n}) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [-1104, 336],
      "id": "b4f2926c-32fd-48d0-8a08-b9b347c273dd",
      "name": "HTTP Request",
      "retryOnFail": true,
      "waitBetweenTries": 2000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "YOUR_GEMINI_API_KEY_CREDENTIAL_ID",
          "name": "Gemini API Key"
        }
      }
    },
    {
      "parameters": {
        "content": "🧠 GENERATE RAG ANSWER / GENERAR RESPUESTA RAG\n\nGemini answers using ONLY the knowledge base as context; if it can't answer from the data, it defers to a human advisor instead of guessing.\nGemini responde usando SOLO la base de conocimiento como contexto; si no puede responder con esos datos, deriva a un asesor humano en vez de inventar.",
        "height": 368,
        "width": 624
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-1152, 128],
      "id": "c50b86d3-b932-4a5a-b179-fdb70f2eb393",
      "name": "Sticky Note3"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "42414201-e973-4143-93d3-c9bb7f2991f1",
              "name": "respuesta_texto",
              "value": "={{ $json.candidates[0].content.parts[0].text }}",
              "type": "string"
            },
            {
              "id": "0d41ed56-3bf8-47fa-a1a3-58e8fd394ccb",
              "name": "telefono_destino",
              "value": "={{ $('Webhook').item.json.body.From.replace(' ', '+') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
