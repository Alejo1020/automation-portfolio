          "id": "YOUR_GEMINI_CREDENTIAL_ID",
          "name": "Gemini API Key"
        }
      }
    },
    {
      "parameters": {
        "content": "🤖 GENERATE POSTS WITH GEMINI / GENERAR POSTS CON GEMINI\n\nSends the topic to Gemini's free tier and returns IG and LinkedIn drafts as JSON.\nEnvía el tema al free tier de Gemini y devuelve borradores de IG y LinkedIn en JSON.",
        "height": 336,
        "width": 560
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-64, -32],
      "id": "dba1a84b-cb4c-4e7f-854c-9009333c4fc8",
      "name": "Sticky Note2"
    },
    {
      "parameters": {
        "jsCode": "const rawText = $input.first().json.candidates[0].content.parts[0].text;\nconst parsed = JSON.parse(rawText);\n\nreturn [{\n  json: {\n    Dia: $('Get row(s) in sheet').first().json.Dia,\n    Fecha: $('Get row(s) in sheet').first().json.Fecha,\n    Tema: $('Get row(s) in sheet').first().json.Tema,\n    Post_IG: parsed.post_ig,\n    Post_LinkedIn: parsed.post_linkedin,\n    Estado: 'Generado'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-928, 624],
