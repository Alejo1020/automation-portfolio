        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [{\n    \"parts\": [{\n      \"text\": \"Eres un calificador de leads para un concesionario de autos. Analiza este mensaje y responde SOLO con JSON: {\\\"score\\\": 1-10, \\\"categoria\\\": \\\"frio/tibio/caliente\\\", \\\"razon\\\": \\\"breve\\\"}. Mensaje del lead: {{ $json.mensaje }}, origen: {{ $json.origen }}\"\n    }]\n  }]\n}",
        "options": {}
