    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const parsed = JSON.parse($json.resultado_limpio);\nreturn {\n  nombre: $('Merge').item.json.nombre,\n  telefono: $('Merge').item.json.telefono,\n  mensaje: $('Merge').item.json.mensaje,\n  origen: $('Merge').item.json.origen,\n  score: parsed.score,\n  categoria: parsed.categoria,\n  razon: parsed.razon,\n  fecha: new Date().toISOString().split('T')[0]\n};"
      },
