    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst leads = items.map(i => i.json);\n\nconst total = leads.length;\nconst calientes = leads.filter(l => l.categoria === 'caliente').length;\nconst tibios = leads.filter(l => l.categoria === 'tibio').length;\nconst frios = leads.filter(l => l.categoria === 'frio').length;\nconst porForm = leads.filter(l => l.origen === 'form').length;\nconst porWhatsapp = leads.filter(l => l.origen === 'WhatsApp').length;\n\nreturn [{\n  json: {\n    fecha: new Date().toISOString().split('T')[0],\n    total_leads: total,\n    calientes,\n    tibios,\n    frios,\n    por_form: porForm,\n    por_whatsapp: porWhatsapp\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        528
      ],
      "id": "276081b7-6074-4e67-84d1-fa39b2a0f7d4",
      "name": "Code (calcular métricas del día)"
    },
    {
      "parameters": {
        "content": "📊 CALCULATE TODAY'S METRICS\nCounts total leads, breakdown by category\n(cold/warm/hot) and by channel (form/WhatsApp).\nInput for the summary the owner receives.\n\n---\n\n📊 CALCULAR MÉTRICAS DEL DÍA\nCuenta total de leads, breakdown por categoría\n(frío/tibio/caliente) y por canal (form/WhatsApp).\nInsumo para el resumen que recibe el dueño.",
