        "googleSheetsOAuth2Api": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nlet html = `<h2>Reporte Semanal de Leads</h2>`;\nhtml += `<p>Total leads: ${items.length}</p>`;\nhtml += `<table border=\"1\" cellpadding=\"8\" cellspacing=\"0\" style=\"border-collapse:collapse;\">`;\nhtml += `<tr><th>Fecha</th><th>Nombre</th><th>Teléfono</th><th>Fuente</th><th>Estado</th></tr>`;\n\nfor (const item of items) {\n  const d = item.json;\n  html += `<tr><td>${d.Fecha}</td><td>${d.Nombre}</td><td>${d.Telefono}</td><td>${d.Fuente}</td><td>${d.Estado}</td></tr>`;\n}\n\nhtml += `</table>`;\n\nreturn [{ json: { htmlReport: html, totalLeads: items.length } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -160,
        -128
